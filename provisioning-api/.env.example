# Database SQLite lưu trữ trong container Docker (/data/provisioning.db tương ứng với ./data/db ngoài host)
DATABASE_URL="file:/data/provisioning.db"

# Token xuất xưởng bí mật (Bắt buộc phải khớp với token cài đặt trên Drone)
PROVISION_SECRET_TOKEN="FACTORY_SECRET_KEY_2026"

# Cấu hình WireGuard VPN Server trên VPS
WG_SERVER_PUBLIC_KEY="YOUR_SERVER_PUBLIC_KEY"
WG_SERVER_ENDPOINT="103.253.20.32:10006"
WG_SERVER_ALLOWED_IPS="10.13.37.0/24"
WG_SERVER_PERSISTENT_KEEPALIVE=25
WG_INTERFACE="wg0"
VPN_SUBNET_PREFIX="10.13.37."

# Cấu hình MAVLink Router
MAVLINK_TARGET_HOST="10.13.37.1"
MAVLINK_TARGET_PORT="14550"

# Cấu hình Redis Cache & Pub/Sub (Chạy cổng 6380)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_DB=0

# Cổng mở Web Dashboard & API Gateway
PORT=10004
