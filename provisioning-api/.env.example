# Cấu hình WireGuard VPN Server trên VPS
# (Ghi chú: Public Key của VPS sẽ được hệ thống tự động đọc từ card mạng wg0, không cần điền thủ công)
WG_SERVER_ENDPOINT="103.253.20.32:10006"
WG_SERVER_ALLOWED_IPS="10.13.37.0/24"
WG_SERVER_PERSISTENT_KEEPALIVE=25
WG_INTERFACE="wg0"
VPN_SUBNET_PREFIX="10.13.37."

# Cấu hình MAVLink Router (nhận từ Drone)
MAVLINK_TARGET_HOST="10.13.37.1"
MAVLINK_TARGET_PORT="14550"

# Cấu hình Redis Cache & Pub/Sub (Chạy cổng 6380)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_PASSWORD=""
