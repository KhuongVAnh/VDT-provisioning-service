# =================================================================
#  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG: PROVISIONING API & DASHBOARD
# =================================================================

# 1. CSDL SQLite (Lưu trong container tại /data/provisioning.db)
DATABASE_URL="file:/data/provisioning.db"

# 2. Secret Token xuất xưởng (Khớp với token cài đặt trên Drone)
PROVISION_SECRET_TOKEN="FACTORY_SECRET_KEY_2026"

# 3. Cấu hình WireGuard VPN Server trên VPS
# (Ghi chú: Public Key của VPS được tự động đọc từ card mạng wg0)
WG_SERVER_ENDPOINT="103.253.20.32:10006"
WG_SERVER_ALLOWED_IPS="10.13.37.0/24"
WG_SERVER_PERSISTENT_KEEPALIVE=25
WG_INTERFACE="wg0"
VPN_SUBNET_PREFIX="10.13.37."

# 4. Cấu hình Redis Cache & Pub/Sub
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_DB=0

# 5. Cổng mở Web Dashboard & REST API (Cổng duy nhất ra Internet)
PORT=10004

# 6. Cấu hình kết nối MediaMTX nội bộ (Video Gateway tập trung qua Port 10004)
# (Đóng toàn bộ cổng 10001, 10005 ra ngoài Internet)
INTERNAL_MTX_HOST="127.0.0.1"
INTERNAL_MTX_RTSP_PORT=8554
INTERNAL_MTX_HLS_PORT=8888
INTERNAL_MTX_WHEP_PORT=8889

