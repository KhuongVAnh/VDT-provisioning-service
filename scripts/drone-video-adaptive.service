[Unit]
Description=Drone Adaptive Bitrate Video Streaming Service (BVLOS 5G)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/drone
Environment="GATEWAY_VPN_IP=10.13.37.1"
Environment="RTSP_PORT=8554"
Environment="PROTOCOL=rtsp"
Environment="VIDEO_DEV=/dev/video0"
ExecStart=/bin/bash /opt/drone/drone_stream_adaptive.sh
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=5

# Cấu hình bảo vệ tài nguyên
LimitNOFILE=65535
Nice=-10

[Install]
WantedBy=multi-user.target
