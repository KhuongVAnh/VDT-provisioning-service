# =================================================================
#  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG: TELEMETRY INGESTION SERVICE
# =================================================================

# 1. Cấu hình nhận gói tin MAVLink UDP từ Drone qua WireGuard VPN
UDP_LISTEN_ADDR="0.0.0.0:14551"

# 2. Cấu hình kết nối Redis Cache & Pub/Sub
REDIS_ADDR="127.0.0.1:6380"
REDIS_PASSWORD=""
REDIS_DB=0

# 4. Thời gian sống (TTL) của trạng thái tức thời trong Redis (giây)
STATE_TTL_SECONDS=30

# 5. Tần suất đẩy dữ liệu tổng hợp ra kênh Pub/Sub (mili-giây) và Tần số tối đa (Hz)
PUBLISH_INTERVAL_MS=50
MAX_PUBLISH_RATE_HZ=20

# 6. Phương ngữ MAVLink mặc định
MAVLINK_DIALECT="ardupilotmega"

# 7. Tiền tố dải mạng VPN để phân giải IP Drone
VPN_SUBNET_PREFIX="10.13.37."
