# Cấu hình MAVLink UDP Ingestion
# Mặc định lắng nghe tại cổng 14551 (nhận luồng chuyển tiếp từ mavlink-routerd trên VPS)
UDP_LISTEN_ADDR=":14551"

# Cấu hình Redis (Chạy cổng 6380)
REDIS_ADDR="127.0.0.1:6380"
REDIS_PASSWORD=""
REDIS_DB=0

# Thời gian sống (TTL) của trạng thái tức thời (giây)
STATE_TTL_SECONDS=30

# Tần suất đẩy dữ liệu tổng hợp ra Redis Pub/Sub (mili-giây: 100ms = 10Hz)
PUBLISH_INTERVAL_MS=100

# Phương ngữ MAVLink mặc định
MAVLINK_DIALECT="ardupilotmega"
