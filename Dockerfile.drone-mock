FROM linuxserver/ffmpeg:latest

WORKDIR /app

# Mặc định sinh video mẫu 720p@30fps nếu không mount video ngoài vào
RUN ffmpeg -f lavfi -i testsrc=size=1280x720:rate=30 -t 15 -c:v libx264 -pix_fmt yuv420p /app/sample_drone_video.mp4 -y

ENV SERVER_HOST=127.0.0.1
ENV SERVER_RTSP_PORT=8554
ENV DRONE_ID=DRONE-SIM-0001
ENV VIDEO_FILE=/app/sample_drone_video.mp4

CMD ffmpeg -re -stream_loop -1 -i ${VIDEO_FILE} \
    -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline \
    -b:v 2000k -maxrate 2500k -bufsize 4000k \
    -pix_fmt yuv420p -g 30 -an \
    -f rtsp -rtsp_transport tcp \
    rtsp://${SERVER_HOST}:${SERVER_RTSP_PORT}/live/${DRONE_ID}
