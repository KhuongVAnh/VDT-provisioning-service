# =================================================================
#  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG TỔNG THỂ (ROOT STACK CONFIG)
# =================================================================
# File này tổng hợp biến môi trường cho toàn bộ hệ thống khi chạy
# bằng Docker Compose (PostgreSQL + Provisioning API + Ingestion + Redis + Media Server).

# === 1. CHUNG & HỆ THỐNG MẠNG VPN ===
VPS_PUBLIC_IP="127.0.0.1"
VPN_SUBNET_PREFIX="10.13.37."
PORT=10004

# === 2. CƠ SỞ DỮ LIỆU POSTGRESQL ===
# Hỗ trợ tùy chỉnh cổng qua POSTGRES_PORT để tránh xung đột với các instance Postgres khác trên VPS
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="provisioning_db"
DATABASE_URL="postgresql://postgres:postgres_password@127.0.0.1:5432/provisioning_db?schema=public"

# === 3. XÁC THỰC & QUẢN TRỊ VIÊN (AUTH & SEED) ===
ADMIN_DEFAULT_EMAIL="admin@gmail.com"
ADMIN_DEFAULT_PASSWORD="admin"
JWT_SECRET="super-secret-key-for-jwt-token-sbcloud-xblink"

# === 4. PROVISIONING API & DASHBOARD (NestJS) ===
PROVISION_SECRET_TOKEN="FACTORY_SECRET_KEY_2026"
WG_SERVER_ENDPOINT="103.253.20.32:10006"
WG_SERVER_ALLOWED_IPS="10.13.37.0/24"
WG_SERVER_PERSISTENT_KEEPALIVE=25
WG_INTERFACE="wg0"

# === 5. TELEMETRY INGESTION SERVICE (Golang) ===
UDP_LISTEN_ADDR="0.0.0.0:14551"
TCP_GCS_PORT="10002"
MAVLINK_TARGET_HOST="10.13.37.1"
MAVLINK_TARGET_PORT=14551
DRONE_UPLINK_UDP_PORT=14551
STATE_TTL_SECONDS=30
PUBLISH_INTERVAL_MS=100
MAVLINK_DIALECT="ardupilotmega"

# === 6. REDIS BROKER & CACHE ===
# Hỗ trợ tùy chỉnh cổng qua REDIS_PORT để tránh xung đột với Redis khác trên VPS
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_ADDR="127.0.0.1:6380"

# === 7. MEDIA SERVER (MediaMTX Video Gateway) ===
# Toàn bộ luồng Video được gom về Port 10004 của NestJS Gateway.
INTERNAL_MTX_HOST="127.0.0.1"
INTERNAL_MTX_RTSP_PORT=8554
INTERNAL_MTX_HLS_PORT=8888
INTERNAL_MTX_WHEP_PORT=8889
