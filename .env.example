# =================================================================
#  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (ENV CONFIGURATION)
# =================================================================

# 1. Database SQLite (Lưu trong container tại /data/provisioning.db)
DATABASE_URL="file:/data/provisioning.db"

# 2. Secret Token cấp phát bảo mật (Khớp với token cấu hình trên Drone)
PROVISION_SECRET_TOKEN="FACTORY_SECRET_KEY_2026"

# 3. Cấu hình WireGuard VPN Server trên VPS
WG_SERVER_PUBLIC_KEY="YOUR_SERVER_PUBLIC_KEY"
WG_SERVER_ENDPOINT="103.253.20.32:10006"
WG_SERVER_ALLOWED_IPS="10.13.37.0/24"
WG_SERVER_PERSISTENT_KEEPALIVE=25
WG_INTERFACE="wg0"
VPN_SUBNET_PREFIX="10.13.37."

# 4. Cấu hình MAVLink Router
MAVLINK_TARGET_HOST="10.13.37.1"
MAVLINK_TARGET_PORT="14550"

# 5. Cấu hình Redis Server (Chạy nội bộ cổng 6380)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_DB=0

# 6. Cổng mở Web Dashboard & API Gateway
PORT=10004
